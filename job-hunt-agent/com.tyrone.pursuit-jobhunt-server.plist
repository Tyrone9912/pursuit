<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tyrone.pursuit-jobhunt-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOUR_USERNAME/Developer/Pursuit/job-hunt-agent/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/Developer/Pursuit/job-hunt-agent</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Developer/Pursuit/job-hunt-agent/logs/server.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Developer/Pursuit/job-hunt-agent/logs/server.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
